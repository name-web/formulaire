# Template for the testing environment file.
#
# The recommended setup is to start from your local .env so the test run keeps
# the same application settings, then adjust the database block:
#
#   cp .env .env.testing
#   php artisan key:generate --env=testing   (if APP_KEY is empty)
#
# .env.testing is git-ignored: NEVER commit real credentials.
#
# Only these four variables are applied before boot by bootstrap/testing-env.php:
#   DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD
# Everything else behaves like a regular Laravel environment file.
#
# The test database NAME and CONNECTION are pinned in phpunit.xml on purpose
# (they are not secrets) so RefreshDatabase can never target a real database.

APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=form_db_test
DB_USERNAME=your_test_user
DB_PASSWORD=your_test_password
